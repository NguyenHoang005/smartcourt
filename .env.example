# Copy file này thành .env ở thư mục gốc dự án và điền thông tin thật của bạn.
# Tuyệt đối KHÔNG commit file .env lên Git.

DB_URL=jdbc:mysql://localhost:3306/smartcourt?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Khóa bí mật ký JWT (tối thiểu 256-bit / 64 ký tự hex), nhớ đổi khi deploy
JWT_SECRET=your_base64_encoded_secret_key_min_32_bytes_here
JWT_EXPIRATION_MS=86400000
